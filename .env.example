# Copy this file to ".env" and change the values you need.
# Every setting has a sensible default, so the app also runs without a .env file.

# SQLAlchemy URL. SQLite is a relational DB and needs zero setup.
# For PostgreSQL use e.g. postgresql+psycopg://user:pass@localhost/sealwright
DATABASE_URL=sqlite:///./storage/sealwright.db

# Where generated PDFs are written
STORAGE_DIR=./storage/certificates

# Used to sign every certificate (HMAC). CHANGE THIS in real deployments.
SECRET_KEY=change-me-please

# Base URL printed inside each certificate's QR code
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Background worker threads (each job is processed by one worker)
WORKER_THREADS=2

# Safety limit for one request
MAX_RECIPIENTS=5000

# Artificial delay per certificate in milliseconds. Set to ~150 to watch the
# progress bar animate during a demo. Keep 0 normally.
GENERATION_DELAY_MS=0

# true = process inside the request (used by the tests), false = background threads
PROCESS_INLINE=false
